# DevUtils environment example — safe template, no real values.
# Production keeps these in /etc/devutils/devutils.env (never commit that file).

# Required. "production" for the EC2 deployment.
NODE_ENV=production

# Required. Public origin only — no path, query, or fragment. Must be https in production.
APP_URL=https://devutils.example.com

# Optional. Internal HTTP port of the Node gateway (default 3000).
PORT=3000

# Optional. Extra origins allowed for state-changing requests, comma-separated.
# Same-origin Host matches are already allowed; list e.g. a preview hostname here.
ALLOWED_ORIGINS=

# Required. Supabase project URL (https://<project-ref>.supabase.co).
SUPABASE_URL=https://your-project-ref.supabase.co

# Required. Supabase publishable (anon) key — safe to expose to the browser.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Required. Supabase service-role key — SERVER ONLY. Never expose to the browser,
# bundles, logs, or Git. Must differ from the publishable key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
