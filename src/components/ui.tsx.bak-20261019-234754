export function Tabs({ tabs, active, onChange, ariaLabel }: { tabs: { id: string; label: string; hint?: string }[]; active: string; onChange: (id: string) => void; ariaLabel?: string }) {
  const ref = useRef<HTMLDivElement>(null);
  return (
    <div ref={ref} role="tablist" aria-label={ariaLabel ?? "Operations"}
      className="flex flex-wrap gap-1 rounded-xl bg-zinc-100 p-1 dark:bg-zinc-900">
      {tabs.map((t) => (
        <button key={t.id} role="tab" aria-selected={active === t.id} title={t.hint}
          onClick={() => onChange(t.id)}
          onKeyDown={(e) => {
            if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
            e.preventDefault();
            const idx = tabs.findIndex((x) => x.id === active);
            const next = (idx + (e.key === "ArrowRight" ? 1 : -1) + tabs.length) % tabs.length;
            onChange(tabs[next].id);
          }}
          className={cn(
            "rounded-lg px-3 py-1.5 text-[13px] font-medium transition",
            active === t.id
              ? "bg-white text-zinc-900 shadow-sm dark:bg-zinc-800 dark:text-white"
              : "text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100"
          )}>
          {t.label}
        </button>
      ))}
    </div>
  );
}

export function CodeArea({ value, onChange, placeholder, label, rows = 12, accept, onFile, mono = true, error }: {
  value: string; onChange: (v: string) => void; placeholder?: string; label: string; rows?: number;
  accept?: string; onFile?: (text: string, name: string) => void; mono?: boolean; error?: string | null;
}) {
  const [drag, setDrag] = useState(false);
  const fileRef = useRef<HTMLInputElement>(null);
  const drop = (e: DragEvent) => {
    e.preventDefault(); setDrag(false);
    const f = e.dataTransfer.files?.[0];
    if (f && onFile) f.text().then((t) => onFile(t, f.name)).catch(() => { /* noop */ });
    else if (f) f.text().then(onChange).catch(() => { /* noop */ });
  };
  return (
    <div>
      <div className="mb-1.5 flex items-center justify-between">
        <span className="text-[12px] font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{label}</span>
        <div className="flex items-center gap-1">
          {onFile !== undefined && (
            <>
              <button type="button" onClick={() => fileRef.current?.click()} title="Upload file"
                className="rounded-md p-1.5 text-zinc-400 hover:bg-zinc-100 hover:text-zinc-700 dark:hover:bg-zinc-800 dark:hover:text-zinc-200">
                <Upload size={14} />
              </button>
              <input ref={fileRef} type="file" accept={accept} className="hidden" onChange={(e) => {
                const f = e.target.files?.[0];
                if (f) f.text().then((t) => (onFile ? onFile(t, f.name) : onChange(t))).catch(() => { /* noop */ });
                e.target.value = "";
              }} />
            </>
          )}
          {value && <span className="font-mono text-[11px] text-zinc-400">{value.length.toLocaleString()} chars</span>}
        </div>
      </div>
      <div onDragOver={(e) => { e.preventDefault(); setDrag(true); }} onDragLeave={() => setDrag(false)} onDrop={drop}
        className={cn("relative overflow-hidden rounded-xl border transition",
          drag ? "border-emerald-500 ring-2 ring-emerald-500/20" : error ? "border-red-400 dark:border-red-800" : "border-zinc-300 dark:border-zinc-700")}>
        <textarea value={value} onChange={(e) => onChange(e.target.value)} placeholder={placeholder} rows={rows} spellCheck={false}
          aria-label={label}
          className={cn("editor block w-full resize-y bg-white px-3.5 py-3 text-zinc-900 outline-none dark:bg-zinc-900 dark:text-zinc-100", !mono && "font-sans")} />
        {!value && (
          <div className="pointer-events-none absolute inset-x-0 bottom-2 text-center text-[11px] text-zinc-400">
            Paste, drop a file, or start typing
          </div>
        )}
      </div>
      {error && <p role="alert" className="mt-2 text-[13px] text-red-600 dark:text-red-400">{error}</p>}
    </div>
  );
}

