/* ---------- hooks ---------- */

export function usePreferenceStorage<T>(key: "du:theme", initial: T): [T, (v: T | ((p: T) => T)) => void] {
  const [val, setVal] = useState<T>(() => {
    try { const raw = localStorage.getItem(key); return raw !== null ? JSON.parse(raw) as T : initial; } catch { return initial; }
  });
  const set = useCallback((v: T | ((p: T) => T)) => {
    setVal((prev) => {
      const next = typeof v === "function" ? (v as (p: T) => T)(prev) : v;
      try { localStorage.setItem(key, JSON.stringify(next)); } catch { /* noop */ }
      return next;
    });
  }, [key]);
  return [val, set];
}

export function useFavorites() {
  const [favs, setFavs] = useState<string[]>([]);
  useEffect(() => platform.favorites.subscribe((items) => {
    setFavs(items.filter((item) => item.kind === "tool").map((item) => item.targetId));
  }), []);
  const toggle = useCallback((id: string) => { void platform.favorites.toggle("tool", id); }, []);
  return { favs, toggle, has: (id: string) => favs.includes(id) };
}

export function useEntityFavorite(kind: "tool" | "toolkit" | "workflow" | "integration", targetId: string) {
  const [active, setActive] = useState(false);
  useEffect(() => platform.favorites.subscribe((items) => setActive(items.some((item) => item.kind === kind && item.targetId === targetId))), [kind, targetId]);
  const toggle = useCallback(() => { void platform.favorites.toggle(kind, targetId); }, [kind, targetId]);
  return { active, toggle };
}

export function useRecents() {
  const [recents, setRecents] = useState<string[]>([]);
  useEffect(() => platform.recentTools.subscribe((items) => setRecents(items.map((item) => item.toolId))), []);
  const push = useCallback((id: string) => { void platform.recentTools.record(id); }, []);
  return { recents, push };
}

export function useCopy(timeout = 1600): [boolean, (t: string) => void] {
  const [ok, setOk] = useState(false);
  const timer = useRef<number | null>(null);
  const copy = useCallback((t: string) => {
    if (!t) return;
    copyText(t).then((done) => {
      if (done) {
        setOk(true);
        if (timer.current) window.clearTimeout(timer.current);
        timer.current = window.setTimeout(() => setOk(false), timeout);
      }
    });
  }, [timeout]);
  useEffect(() => () => { if (timer.current) window.clearTimeout(timer.current); }, []);
  return [ok, copy];
}

