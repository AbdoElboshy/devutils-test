/* ---------- tool page scaffold ---------- */

export function ToolScaffold({ tool, onExample, children, next }: {
  tool: Tool; onExample?: () => void; children: ReactNode;
  next?: { label: string; to: string }[];
}) {
  const { push } = useRecents();
  const auth = useAuth();
  const category = CATEGORIES.find((item) => item.id === tool.category);
  useEffect(() => {
    if (getPrivacyPreferences().recentHistory) push(tool.id);
    track({ name: "tool_opened", toolId: tool.id, categoryId: tool.category });
    if (auth.user && platform.usage) void platform.usage.consume(auth.user.id, "tool_runs", 1, tool.id).catch(() => undefined);
  }, [tool.id, tool.category, push, auth.user]);
  return (
    <div className="mx-auto w-full max-w-6xl px-4 pb-20 pt-6 sm:px-6">
      <nav aria-label="Breadcrumb" className="mb-4 flex items-center gap-1.5 text-[13px] text-zinc-500 dark:text-zinc-400">
        <a href="#/" data-nav="/" className="hover:text-zinc-900 dark:hover:text-zinc-100">Home</a>
        <ChevronRight size={13} />
        <a href={`#/categories/${category?.slug ?? tool.category}`} data-nav={`/categories/${category?.slug ?? tool.category}`} className="capitalize hover:text-zinc-900 dark:hover:text-zinc-100">{category?.name ?? tool.category.replace("-", " ")}</a>
        <ChevronRight size={13} />
        <span className="text-zinc-900 dark:text-zinc-100">{tool.name}</span>
      </nav>

      <div className="mb-4 flex flex-wrap items-start justify-between gap-3">
        <div className="min-w-0">
          <h1 className="text-2xl font-bold tracking-tight text-zinc-900 sm:text-[28px] dark:text-white">{tool.name}</h1>
          <p className="mt-1 max-w-2xl text-[14px] leading-relaxed text-zinc-600 dark:text-zinc-400">{tool.longDescription}</p>
          <div className="mt-2.5 flex flex-wrap items-center gap-2">
            <PrivacyBadge local={tool.clientSide} />
            <div className="flex flex-wrap gap-1.5">
              {tool.capabilities.slice(0, 6).map((c) => (
                <span key={c} className="rounded-md bg-zinc-100 px-2 py-0.5 text-[11.5px] font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{c}</span>
              ))}
            </div>
          </div>
        </div>
        <FavStar id={tool.id} />
      </div>

      <div className="fade-up">{children}</div>

      {next && next.length > 0 && (
        <Panel className="mt-4 p-4">
          <p className="text-[12px] font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400">You may also want</p>
          <div className="mt-2 flex flex-wrap gap-2">
            {next.map((n) => (
              <a key={n.to} href={`#${n.to}`} data-nav={n.to}
                className="inline-flex items-center gap-1 rounded-lg border border-zinc-200 px-3 py-1.5 text-[13px] font-medium text-zinc-700 transition hover:border-emerald-500 hover:text-emerald-700 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-emerald-500 dark:hover:text-emerald-300">
                → {n.label}
              </a>
            ))}
          </div>
        </Panel>
      )}

      <div className="mt-8 grid gap-6 md:grid-cols-2">
        <div>
          <h2 className="text-[15px] font-bold text-zinc-900 dark:text-white">How it works</h2>
          <ol className="mt-2 space-y-1.5">
            {tool.howItWorks.map((s, i) => (
              <li key={i} className="flex gap-2.5 text-[13.5px] text-zinc-600 dark:text-zinc-400">
                <span className="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-zinc-100 font-mono text-[11px] font-bold text-zinc-600 dark:bg-zinc-800 dark:text-zinc-300">{i + 1}</span>
                {s}
              </li>
            ))}
          </ol>
          {tool.example && onExample && (
            <button type="button" onClick={onExample}
              className="mt-3 rounded-lg border border-dashed border-zinc-300 px-3 py-1.5 text-[13px] text-zinc-600 transition hover:border-emerald-500 hover:text-emerald-700 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-emerald-500 dark:hover:text-emerald-300">
              Try example: {tool.example.label}
            </button>
          )}
        </div>
        <div>
          <h2 className="text-[15px] font-bold text-zinc-900 dark:text-white">Related tools</h2>
          <div className="mt-2 grid gap-2 sm:grid-cols-2">
            {tool.related.map((id) => TOOL_MAP[id]).filter(Boolean).map((r) => (
              <a key={r.id} href={`#${r.route}`} data-nav={r.route}
                className="group rounded-lg border border-zinc-200 p-3 transition hover:border-emerald-500 dark:border-zinc-800 dark:hover:border-emerald-600">
                <p className="text-[13.5px] font-semibold text-zinc-900 group-hover:text-emerald-700 dark:text-zinc-100 dark:group-hover:text-emerald-300">{r.name}</p>
                <p className="mt-0.5 line-clamp-2 text-[12.5px] text-zinc-500 dark:text-zinc-400">{r.description}</p>
              </a>
            ))}
          </div>
        </div>
      </div>

      {tool.faq && tool.faq.length > 0 && (
        <div className="mt-6">
          <h2 className="text-[15px] font-bold text-zinc-900 dark:text-white">FAQ</h2>
          <div className="mt-2 space-y-2">
            {tool.faq.map((f, i) => (
              <details key={i} className="rounded-lg border border-zinc-200 px-3.5 py-2.5 dark:border-zinc-800">
                <summary className="cursor-pointer text-[13.5px] font-medium text-zinc-800 dark:text-zinc-200">{f.q}</summary>
                <p className="mt-1.5 text-[13px] leading-relaxed text-zinc-600 dark:text-zinc-400">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}

