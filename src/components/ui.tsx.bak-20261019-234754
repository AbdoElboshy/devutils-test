  return (
    <button type="button" onClick={() => toggle(id)} title={on ? "Remove from favorites" : "Add to favorites"}
      aria-pressed={on} className={cn("rounded-lg p-2 transition", on ? "text-amber-500" : "text-zinc-400 hover:bg-zinc-100 hover:text-zinc-600 dark:hover:bg-zinc-800")}>
      <Star size={17} fill={on ? "currentColor" : "none"} />
